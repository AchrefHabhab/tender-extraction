{
  "name": "tender-extraction-pipeline",
  "version": "1.0.0",
  "description": "AI-powered procurement tender extraction pipeline",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "verify": "npm run type-check && npm run lint"
  },
  "keywords": [
    "llm",
    "pdf-extraction",
    "procurement",
    "deepseek"
  ],
  "author": "Achraf Hebheb",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.4.2",
    "openai": "^6.42.0",
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^7.0.0",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "@types/pdf-parse": "^1.1.5",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript-eslint": "^8.60.1"
  }
}
